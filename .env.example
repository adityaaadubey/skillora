# ==============================================================================
# Skillora - Environment Variables Specification & Security Configuration
# ==============================================================================
# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the client browser.
# DO NOT put database passwords, service role keys, or private API secrets in NEXT_PUBLIC_ variables.

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure (Authentication, Postgres, Storage, Realtime)
# ------------------------------------------------------------------------------
# Your project REST endpoint (safe for public)
NEXT_PUBLIC_SUPABASE_URL=https://xrxrxgygnuqkbexzvxas.supabase.co

# Client-side Anonymous Key (JWT with 'anon' role - safe for public with RLS active)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhyeHJ4Z3lnbnVxa2JleHp2eGFzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA0OTM3NTYsImV4cCI6MjEwNjA2OTc1Nn0.CROromjBhBnigD9Gn4XrLRWb57lawOm1Vkwr3zlMr14

# Server-Side Service Role Key (BYPASSES Row Level Security - NEVER EXPOSE TO CLIENT)
# Used only in isolated backend cron jobs, batch migration scripts, or webhook handlers.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# ------------------------------------------------------------------------------
# 2. Application Core & Domain Configuration
# ------------------------------------------------------------------------------
# Canonical Production URL or Local Dev URL (used for OAuth redirects, sitemaps, open-graph)
NEXT_PUBLIC_APP_URL=https://skillora-live.vercel.app
NEXT_PUBLIC_APP_NAME=Skillora

# ------------------------------------------------------------------------------
# 3. Security & Scheduled Automation (Ingestion Pipeline)
# ------------------------------------------------------------------------------
# High-entropy Bearer token required to trigger /api/ingestion/run in production
# Recommended: Generate a 32+ character random string (e.g., `openssl rand -hex 32`)
CRON_SECRET=skillora_live_production_cron_secret_secure_key_2026

# Optional Admin Invitation / Bootstrap Secret
# ADMIN_SECRET_KEY=skillora_admin_bootstrap_secret_token_2026

# ------------------------------------------------------------------------------
# 4. Support, Founder Contact & In-App Policy Credentials
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@skillora.live
NEXT_PUBLIC_FOUNDER_NAME="Aditya Dubey"
NEXT_PUBLIC_FOUNDER_CONTACT=https://linkedin.com/in/adityadubey
